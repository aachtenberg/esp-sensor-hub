// Secrets for ESP32-S3 Solar Monitor
// Copy this file to secrets.h and fill in your credentials

#ifndef SECRETS_H
#define SECRETS_H

// MQTT broker (Telegraf consumes from this broker and forwards to TimescaleDB)
static const char* MQTT_BROKER   = "192.168.0.167";
static const int   MQTT_PORT     = 1883;
static const char* MQTT_USER     = "";   // leave empty for anonymous
static const char* MQTT_PASSWORD = "";

// OTA firmware update password (ArduinoOTA)
static const char* OTA_PASSWORD  = "change-this-ota-password";

// WiFi credentials are managed at runtime via WiFiManager portal
// (double-reset within 3 seconds to re-enter config mode)

#endif // SECRETS_H
